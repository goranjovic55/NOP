{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "akis",
  "yolo": true,
  "yolo_patterns": [
    "npm test*",
    "npm run*",
    "pytest*",
    "python -m pytest*",
    "python -m py_compile*",
    "npx tsc*",
    "git status*",
    "git log*",
    "git diff*",
    "head *",
    "python .github/scripts/*",
    "docker compose*",
    "docker-compose*"
  ]
}
